# COMMONS — common tasks. Run `make` or `make help` for the list.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

PYTHON   ?= $(if $(wildcard .venv/bin/python),.venv/bin/python,python3)
UV       ?= $(if $(wildcard .venv/bin/uv),.venv/bin/uv,uv)
COMPOSE  ?= docker compose
SECRETS  := secrets
MATRIX_SECRET_DIR := $(SECRETS)/matrix
SECRET_NAMES := internal_api_token llm_api_key database_password
# Created by `make init` and scripts/bot_token.sh after the Matrix services start.
MATRIX_SECRETS := synapse.yaml signing.key mas.yaml postgres_password mas-commons-client.yaml \
                  matrix_admin_client_secret bot_access_token bot_pickle_key
MATRIX_CORE_NAMES := postgres_password synapse.yaml signing.key mas.yaml
MATRIX_ADMIN_NAMES := mas-commons-client.yaml matrix_admin_client_secret
APP_UID  := 10001

# Model weights: fetched once at install time, never at runtime.
# The expected SHA-256 lives in deploy/models.sha256 ("<sha256>  <file>").
MODEL_DIR  ?= models
MODEL_FILE ?= SmolLM3-Q4_K_M.gguf
# Pinned to a repo commit, so the URL never silently points at new weights.
MODEL_URL  ?= https://huggingface.co/ggml-org/SmolLM3-3B-GGUF/resolve/4965cb60b150737b68a0408c36aeefb65078f894/$(MODEL_FILE)
MODEL_SUMS := deploy/models.sha256

PREFLIGHT := scripts/preflight.py

SHA256 := $(shell command -v sha256sum >/dev/null 2>&1 && echo sha256sum || echo "shasum -a 256")

define require
	@test -e "$(1)" || { echo "error: $(1) does not exist yet ($(2))." >&2; exit 1; }
endef

.PHONY: help init install-dev fetch-model verify-model pin-images up down logs seed-demo test lint fmt audit preflight check-domains lock backup check-pushers usage-report verify-log check

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

init: ## Generate app and Matrix bootstrap secrets (0600); copy community.yaml and .env examples
	@command -v openssl >/dev/null || { echo "error: openssl is required for make init" >&2; exit 1; }
	@if [ -e "$(SECRETS)/synapse-trial" ]; then \
	  if [ -e "$(MATRIX_SECRET_DIR)" ]; then \
	    echo "error: both $(SECRETS)/synapse-trial and $(MATRIX_SECRET_DIR) exist; merge them manually before retrying" >&2; exit 1; \
	  fi; \
	  mv "$(SECRETS)/synapse-trial" "$(MATRIX_SECRET_DIR)"; \
	  echo "moved   $(SECRETS)/synapse-trial to $(MATRIX_SECRET_DIR)"; \
	fi
	@umask 077; mkdir -p $(SECRETS); chmod 700 $(SECRETS)
	@for name in $(SECRET_NAMES); do \
	  f="$(SECRETS)/$$name"; \
	  if [ -s "$$f" ]; then if [ -O "$$f" ]; then chmod 600 "$$f"; fi; echo "keep     $$f"; \
	  else (umask 077; openssl rand -hex 32 > "$$f.tmp" && mv "$$f.tmp" "$$f"); chmod 600 "$$f"; echo "created  $$f"; fi; \
	done
	@if [ -f community.yaml ]; then echo "keep     community.yaml"; \
	 else cp community.yaml.example community.yaml; echo "created  community.yaml (review before first start)"; fi
	@if [ -f .env ]; then echo "keep     .env"; \
	 else cp .env.example .env; echo "created  .env"; fi
	@matrix_core_ready=yes; \
	for name in $(MATRIX_CORE_NAMES); do \
	  if [ ! -s "$(MATRIX_SECRET_DIR)/$$name" ]; then matrix_core_ready=no; break; fi; \
	done; \
	if [ "$$matrix_core_ready" = yes ]; then \
	  echo "keep     Synapse/MAS/PostgreSQL bootstrap secrets"; \
	else \
	  $(PYTHON) scripts/synapse_trial_init.py; \
	fi
	@matrix_admin_ready=yes; \
	for name in $(MATRIX_ADMIN_NAMES); do \
	  if [ ! -s "$(MATRIX_SECRET_DIR)/$$name" ]; then matrix_admin_ready=no; break; fi; \
	done; \
	if [ "$$matrix_admin_ready" = yes ]; then \
	  echo "keep     COMMONS MAS admin client"; \
	else \
	  $(PYTHON) scripts/commons_admin_client.py; \
	fi
	@if [ "$$(uname -s)" = Linux ] && [ "$$(id -u)" != $(APP_UID) ]; then \
	  echo "note: on Linux the app container (uid $(APP_UID)) cannot read 0600 files owned by uid $$(id -u)."; \
	  echo "      Run once: sudo chown $(APP_UID):$(APP_UID) $(SECRETS)/*"; \
	fi
	@echo "Generate the bot token after starting Matrix/MAS with scripts/bot_token.sh."
	@echo "The decision-log signing key is generated by the app on first start (data/keys)."

fetch-model: ## Download the GGUF model and verify it against deploy/models.sha256
	$(call require,$(MODEL_SUMS),record the model checksum first)
	@grep -q " $(MODEL_FILE)$$" $(MODEL_SUMS) || { echo "error: no checksum for $(MODEL_FILE) in $(MODEL_SUMS)" >&2; exit 1; }
	@mkdir -p $(MODEL_DIR)
	@if [ ! -f "$(MODEL_DIR)/$(MODEL_FILE)" ]; then \
	  echo "download $(MODEL_URL)"; \
	  curl --fail --location --proto '=https' --tlsv1.2 -o "$(MODEL_DIR)/$(MODEL_FILE).part" "$(MODEL_URL)"; \
	  mv "$(MODEL_DIR)/$(MODEL_FILE).part" "$(MODEL_DIR)/$(MODEL_FILE)"; \
	fi
	@grep " $(MODEL_FILE)$$" $(MODEL_SUMS) | (cd $(MODEL_DIR) && $(SHA256) -c -) \
	  || { echo "error: checksum mismatch, deleting $(MODEL_DIR)/$(MODEL_FILE)" >&2; rm -f "$(MODEL_DIR)/$(MODEL_FILE)"; exit 1; }

verify-model: ## Check the downloaded GGUF against deploy/models.sha256 (run by make up)
	$(call require,$(MODEL_DIR)/$(MODEL_FILE),run make fetch-model first)
	@grep " $(MODEL_FILE)$$" $(MODEL_SUMS) | (cd $(MODEL_DIR) && $(SHA256) -c --quiet -) \
	  || { echo "error: $(MODEL_DIR)/$(MODEL_FILE) does not match $(MODEL_SUMS); delete it and run make fetch-model" >&2; exit 1; }

pin-images: ## Pull registry images and pin Compose/Dockerfile references by digest
	$(PYTHON) scripts/pin_images.py docker-compose.yml

up: verify-model ## Start the stack (docker compose; checks the model checksum first)
	$(call require,docker-compose.yml,compose file is part of M0)
	@for name in $(SECRET_NAMES); do \
	  test -s "$(SECRETS)/$$name" || { echo "error: $(SECRETS)/$$name missing; run make init first" >&2; exit 1; }; \
	done
	@for name in $(MATRIX_SECRETS); do \
	  test -s "$(MATRIX_SECRET_DIR)/$$name" || { echo "error: $(MATRIX_SECRET_DIR)/$$name missing; see \"Run the stack\" in README.md" >&2; exit 1; }; \
	done
	$(call require,community.yaml,run make init first and review community.yaml)
	$(COMPOSE) up -d --build

down: ## Stop the stack
	$(COMPOSE) down

logs: ## Follow service logs
	$(COMPOSE) logs -f --tail=100

bootstrap-admin: ## First start: create the Matrix account NAME in MAS and make it the first COMMONS admin
	@[[ "$${NAME:-}" =~ ^[a-z0-9._=/+-]{1,64}$$ ]] || { echo "usage: make bootstrap-admin NAME=<username>  (lowercase letters, digits, . _ = / + -)" >&2; exit 1; }
	@# Refuse early, before touching MAS, if COMMONS already has an admin.
	$(COMPOSE) exec app python -m app.cli bootstrap-admin "$$NAME" --check
	@if [ "$${MAS_ACCOUNT:-new}" = existing ]; then echo "using the existing Matrix account $$NAME"; \
	 else echo 'Set a password in the menu, then choose "Create the user".'; \
	   $(COMPOSE) exec mas mas-cli manage register-user --config /run/secrets/mas_config "$$NAME"; fi
	$(COMPOSE) exec app python -m app.cli bootstrap-admin "$$NAME"

# The database name is fixed on purpose: this recipe drops it.
seed-demo: ## Rebuild the separate demo database: three days of made-up use (AS_OF=YYYY-MM-DD)
	@printf '%s\n' 'DROP DATABASE IF EXISTS commons_demo;' \
	  'CREATE DATABASE commons_demo OWNER commons;' \
	  'REVOKE CONNECT ON DATABASE commons_demo FROM PUBLIC;' \
	  'GRANT CONNECT ON DATABASE commons_demo TO commons;' \
	  | $(COMPOSE) exec -T postgres psql -q -v ON_ERROR_STOP=1 -U matrix -d postgres
	@$(COMPOSE) exec -T -e COMMONS_ENV=demo -e COMMONS_DATA_DIR=/data/demo \
	  -e COMMONS_DATABASE_URL=postgresql+psycopg://commons@postgres:5432/commons_demo \
	  -e COMMONS_DEMO_MEMBERS="$$(cat demo-members.json 2>/dev/null)" \
	  app python - $(if $(AS_OF),--as-of $(AS_OF)) < scripts/seed_demo.py

TEST_DB_IMAGE := postgres:17.11-alpine@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac

test-db: ## Start a throwaway PostgreSQL for the tests on 127.0.0.1:55432 (no-op if running)
	@docker inspect -f '{{.State.Running}}' commons-test-db 2>/dev/null | grep -q true || \
	  { docker rm -f commons-test-db >/dev/null 2>&1; \
	    docker run -d --name commons-test-db -p 127.0.0.1:55432:5432 \
	      -e POSTGRES_PASSWORD=commons-test --tmpfs /var/lib/postgresql/data $(TEST_DB_IMAGE) >/dev/null; \
	    until docker exec commons-test-db pg_isready -q -U postgres; do sleep 1; done; \
	    echo "test database ready on 127.0.0.1:55432"; }

test: test-db ## Run the test suite against the test PostgreSQL (skips live-LLM evals; use `pytest -m llm`)
	$(PYTHON) -m pytest

lint: ## ruff check + format check
	$(PYTHON) -m ruff check .
	$(PYTHON) -m ruff format --check .

fmt: ## Auto-fix lint issues and format
	$(PYTHON) -m ruff check --fix .
	$(PYTHON) -m ruff format .

audit: ## pip-audit (dependencies) + bandit (code)
	$(PYTHON) -m pip_audit
	$(PYTHON) -m bandit -q -r app bot scripts

preflight: ## Cloud/security preflight check
	$(PYTHON) $(PREFLIGHT) .

check-domains: ## Reject personal developer hostnames in repository files
	$(PYTHON) scripts/check_repository_domains.py

lock: ## Re-resolve uv.lock, export hashed requirements(-dev).lock and bot/requirements.lock
	$(UV) lock
	$(UV) export --frozen --no-dev --no-emit-project --format requirements-txt -q -o requirements.lock
	$(UV) export --frozen --only-group dev --no-emit-project --format requirements-txt -q -o requirements-dev.lock
	$(UV) pip compile bot/requirements.in --python-platform linux --python-version 3.12 \
	  --generate-hashes --no-header --only-binary :all: -q -o bot/requirements.lock

install-dev: ## Install locked runtime + dev deps into .venv (hash-checked)
	$(UV) pip sync --require-hashes requirements.lock requirements-dev.lock

backup: ## Encrypted backup to COMMONS_BACKUP_DIR (age; docs/BACKUP.md)
	scripts/backup.sh

check-pushers: ## Every phone's push registration carries only event ids (no content or sender)
	$(PYTHON) scripts/check_pushers.py

usage-report: ## Anonymous usage numbers from the running box, read-only (FORMAT=csv, SINCE=YYYY-MM-DD)
	@$(COMPOSE) exec -T app python - --format $(or $(FORMAT),markdown) $(if $(SINCE),--since $(SINCE)) < scripts/usage_report.py

verify-log: ## Verify a downloaded decision log offline (LOG=export.jsonl KEYS=keys.json [ANCHOR=seq:hash])
	@test -n "$(LOG)" -a -n "$(KEYS)" || { echo "usage: make verify-log LOG=commons-decision-log.jsonl KEYS=commons-log-keys.json" >&2; exit 2; }
	$(PYTHON) scripts/verify_log.py "$(LOG)" --pubkeys "$(KEYS)" $(if $(ANCHOR),--anchor $(ANCHOR))

check: lint test preflight check-domains ## Everything CI runs locally
