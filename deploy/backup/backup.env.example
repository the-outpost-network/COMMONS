# /etc/commons/backup.env (root:commons, 0640). No secrets in here: only public keys.
# The backup disk: another device than the box's SSD, mounted here.
COMMONS_BACKUP_DIR=/mnt/commons-backup
# age public keys (age1…), one per line; their private keys never live on the box.
COMMONS_BACKUP_RECIPIENTS=/etc/commons/backup-recipients.txt
# How many nightly backups to keep on the disk.
COMMONS_BACKUP_KEEP=14
